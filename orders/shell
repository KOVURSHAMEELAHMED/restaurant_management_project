import logging
from django.core.mail import send_mail
from django.conf import settings
from django.core.exceptions import ValidationError
from django.core.validators import validate_email

# Set up logging to track failures
logger = logging.getLogger(__name__)

def send_order_confirmation_email(order_id, customer_email, customer_name, total_amount):
    """
    Sends an order confirmation email for the Hotel Management System.
    """
    subject = f"Booking Confirmation - Order #{order_id}"
    
    message = (
        f"Hi {customer_name},\n\n"
        f"Thank you for choosing our hotel! Your booking (Order #{order_id}) has been confirmed.\n"
        f"Total Amount: ${total_amount}\n\n"
        "We look forward to seeing you soon!"
    )
    
    from_email = settings.DEFAULT_FROM_EMAIL

    try:
        # 1. Basic email validation
        validate_email(customer_email)

        # 2. Send the email
        # fail_silently=False allows us to catch the exception in the 'except' block
        send_mail(
            subject,
            message,
            from_email,
            [customer_email],
            fail_silently=False,
        )
        return {"status": "success", "message": "Email sent successfully."}

    except ValidationError:
        logger.error(f"Invalid email address provided: {customer_email}")
        return {"status": "error", "message": "The provided email address is invalid."}

    except Exception as e:
        logger.error(f"Failed to send email for Order #{order_id}: {str(e)}")
        return {"status": "error", "message": "Could not send email due to a server or connection error."}